library 'reference-pipeline'
pipeline {
    agent any

    parameters {
        choice(name: 'ENVIRONMENT', choices: ['dev', 'prod'], description: 'Select the environment to deploy to')
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout') {
            steps {
                echo "Checkout stage running from SCM-sourced Jenkinsfile"
                sh 'ls -la'
            }
        }

        stage('Prepare-Environment') {
            steps {
                retry(2) {
                    prepareNodeEnv('paymentservice')
                }
            }
        }

        stage('Unit-Tests') {
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                    sh '''
                      docker run --rm \
                        -v jenkins_home:/var/jenkins_home \
                        -w ${WORKSPACE}/src/paymentservice \
                        node:20-alpine \
                        sh -c "npm test"
                    '''
                }
            }
        }

        stage('Build') {
            steps {
                retry(3) {
                    buildDockerImage('paymentservice', env.BUILD_NUMBER)
                }
            }
        }

        stage('security-scan') {
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                    trivyScan('paymentservice', env.BUILD_NUMBER)
                }
            }
        }

        stage('Push') {
            steps {
                script {
                    pushToDockerHub('rajesh984', 'paymentservice', env.BUILD_NUMBER, 'dockerhub-creds')
                }
            }
        }

        stage('Approval') {
            when {
                anyOf {
                    expression { params.ENVIRONMENT == 'prod' }
                    branch 'main'
                }
            }
            steps {
                input message: "Approve deployment of paymentservice to PRODUCTION from main branch?", ok: "Deploy"
            }
        }

        stage('Deploy') {
            steps {
                deployToK8s('rajesh984', 'paymentservice', env.BUILD_NUMBER, 'kubeconfig-docker-desktop', 'kubernetes-manifests/paymentservice.yaml')
            }
        }
    }

    post {
        success {
            echo "Pipeline succeeded — paymentservice:${BUILD_NUMBER} deployed to ${params.ENVIRONMENT}"
            build job: 'post-deploy-notify', wait: false
        }
        unstable {
            echo "Pipeline finished UNSTABLE — check Unit-Tests / security-scan findings for paymentservice:${BUILD_NUMBER}"
        }
        failure {
            echo "Pipeline FAILED for paymentservice:${BUILD_NUMBER} — check console output"
        }
        always {
            echo "Pipeline finished with result: ${currentBuild.result}"
        }
    }
}

// Testing webhook
