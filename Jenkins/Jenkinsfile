pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps {
                echo "Checkout stage running from SCM-sourced Jenkinsfile"
                sh 'ls -la'
            }
        }
    }
}
        stage('Prepare-Environment') {
             steps {
                sh '''
                  docker run --rm \
                 -v jenkins_home:/var/jenkins_home \
                 -w ${WORKSPACE}/src/currencyservice \
                 node:20-alpine \
                 sh -c "node -v && npm -v && if [ -f package-lock.json ]; then npm ci --no-audit --no-fund; else npm install --legacy-peer-deps --no-audit --no-fund; fi"
               '''
    }
}