library 'reference-pipeline'
pipeline {
    agent any

    parameters {
        choice(name: 'ENVIRONMENT', choices: ['dev',  'prod'], description: 'Select the environment to deploy to')
    }

    stages {
        stage('Checkout') {
            steps {
                echo "Checkout stage running from SCM-sourced Jenkinsfile"
                sh 'ls -la'
            }
        }

        stage('Prepare-Environment') {
           steps {
             retry(3) {
               sh '''
                docker run --rm \
                -v jenkins_home:/var/jenkins_home \
                -w ${WORKSPACE}/src/currencyservice \
                 node:20-alpine \
                sh -c "apk add --update --no-cache python3 make g++ && node -v && npm -v && if [ -f package-lock.json ]; then npm ci --no-audit --no-fund; else npm install --legacy-peer-deps --no-audit --no-fund; fi"
                 '''
             }
    }
}
       stage('Unit-Tests') {
        steps {
          catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
            sh '''
              docker run --rm \
                -v jenkins_home:/var/jenkins_home \
                -w ${WORKSPACE}/src/currencyservice \
                node:20-alpine \
                sh -c "npm test"
            '''
        }
    }
}
        
        stage('Build') {
            steps{
                retry(3) {
                    buildDockerImage('currencyservice', env.BUILD_NUMBER)
                }
            }
        }

        stage('security-scan') {
                steps {
                 catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                 sh 'trivy image --severity CRITICAL --exit-code 1 currencyservice:${BUILD_NUMBER}'
                 }
    }
}
        stage('Push') {
             steps {
               script {
                 docker.withRegistry('https://index.docker.io/v1/', 'dockerhub-creds') {
                 sh 'docker tag currencyservice:${BUILD_NUMBER} rajesh984/currencyservice:${BUILD_NUMBER}'
                 sh 'docker push rajesh984/currencyservice:${BUILD_NUMBER}'
            }
        }
    }
}

       stage('Approval') {
               when {
                 expression { params.ENVIRONMENT == 'prod' }
                }
                steps {
                   input message: "Approve deployment of currencyservice to PRODUCTION?", ok: "Deploy"
    }
}
       stage('Deploy') {
         steps {
           withKubeConfig(credentialsId: 'kubeconfig-docker-desktop') {
            sh '''
              sed -i "s|image: currencyservice|image: rajesh984/currencyservice:${BUILD_NUMBER}|" kubernetes-manifests/currencyservice.yaml
              kubectl apply -f kubernetes-manifests/currencyservice.yaml
              kubectl rollout status deployment/currencyservice --timeout=60s
            '''
        }
    }
}
    }
 post {
      success {
        echo "Pipeline succeeded — currencyservice:${BUILD_NUMBER} deployed to ${params.ENVIRONMENT}"
    }
      unstable {
        echo "Pipeline finished UNSTABLE — check Unit-Tests / security-scan findings for currencyservice:${BUILD_NUMBER}"
    }
      failure {
        echo "Pipeline FAILED for currencyservice:${BUILD_NUMBER} — check console output"
    }
      always {
        echo "Pipeline finished with result: ${currentBuild.result}"
    }
}
    }
