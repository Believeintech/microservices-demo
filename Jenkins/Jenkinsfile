library 'reference-pipeline'
pipeline {
    agent any

    parameters {
        choice(name: 'ENVIRONMENT', choices: ['dev',  'prod'], description: 'Select the environment to deploy to')
    }

    options {
       buildDiscarder(logRotator(numToKeepStr: '10'))
       timeout(time: 30, unit: 'MINUTES')
       disableConcurrentBuilds()
}

    stages {
        stage('Checkout') {
            steps {
                echo "Checkout stage running from SCM-sourced Jenkinsfile"
                sh 'ls -la'
            }
        }

    stage('Check Skip CI') {
    steps {
        script {
            def lastCommitMsg = sh(script: 'git log -1 --pretty=%B', returnStdout: true).trim()
            if (lastCommitMsg.contains('[skip ci]')) {
                currentBuild.result = 'NOT_BUILT'
                error("Skipping build — last commit marked [skip ci]")
            }
        }
    }
}

        stage('Prepare-Environment') {
           steps {
             retry(3) {
               sh '''
                docker run --rm \
                -v jenkins_home:/var/jenkins_home \
                -w ${WORKSPACE}/src/currencyservice \
                 node:20-alpine \
                sh -c "apk add --update --no-cache python3 make g++ && node -v && npm -v && if [ -f package-lock.json ]; then npm ci --no-audit --no-fund; else npm install --legacy-peer-deps --no-audit --no-fund; fi"
                 '''
             }
    }
}
       stage('Unit-Tests') {
        steps {
          catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
            sh '''
              docker run --rm \
                -v jenkins_home:/var/jenkins_home \
                -w ${WORKSPACE}/src/currencyservice \
                node:20-alpine \
                sh -c "npm test"
            '''
        }
    }
}
        
        stage('Build') {
            steps{
                retry(3) {
                    buildDockerImage('currencyservice', env.BUILD_NUMBER)
                }
            }
        }

        stage('security-scan') {
                steps {
                 catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                 trivyScan('currencyservice', env.BUILD_NUMBER)
                 }
    }
}
        stage('Push') {
             steps {
               script {
                 pushToDockerHub('rajesh984', 'currencyservice', env.BUILD_NUMBER, 'dockerhub-creds')
               }
             }
    }


       stage('Approval') {
               when {
                 expression { params.ENVIRONMENT == 'prod' }
                }
                steps {
                   input message: "Approve deployment of currencyservice to PRODUCTION ?", ok: "Deploy"
    }
}
       stage('Deploy') {
    steps {
        script {
            updateManifestInGit('rajesh984', 'currencyservice', env.BUILD_NUMBER, 'kubernetes-manifests/currencyservice.yaml', 'github-creds')
        }
    }
}

    }
    
    
    post {
      success {
        echo "Pipeline succeeded — currencyservice:${BUILD_NUMBER} deployed to ${params.ENVIRONMENT}"
        build job: 'post-deploy-notify', wait: false
    }
      unstable {
        echo "Pipeline finished UNSTABLE — check Unit-Tests / security-scan findings for currencyservice:${BUILD_NUMBER}"
    }
      failure {
        echo "Pipeline FAILED for currencyservice:${BUILD_NUMBER} — check console output"
    }
      always {
        echo "Pipeline finished with result: ${currentBuild.result}"
    }
}

}

